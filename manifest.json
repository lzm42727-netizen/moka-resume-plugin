{
  "manifest_version": 3,
  "name": "Moka 智能简历筛选助手",
  "version": "1.8.7",
  "description": "基于 AI 的 Moka 候选人筛选插件，自动匹配 JD 要求并给出评分建议",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://app.mokahr.com/*",
    "https://*.mokahr.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Moka 智能筛选助手",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.mokahr.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.mokahr.com/*"],
      "js": ["lib/contracts.js", "lib/score.js", "lib/capture.js", "lib/persist.js", "lib/feedback.js", "lib/screening-job.js", "lib/usage.js", "lib/moka-actions.js", "lib/match.js", "lib/candidate-profile.js", "lib/batch.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
